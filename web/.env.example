# Copiar a .env.local (local/Codespaces) o cargar en el panel del hosting.
# NUNCA subir valores reales al repositorio. Un valor vacío = "pendiente": ese elemento no se muestra.

# ── Datos públicos del sitio (no son secretos) ───────────────────────────────
# WhatsApp con código de país; acepta "+1 555 123 4567". Activa el botón flotante y la barra inferior.
NEXT_PUBLIC_WHATSAPP=
# Perfil de Instagram (https://...)
NEXT_PUBLIC_INSTAGRAM_URL=
# Correo y teléfono visibles en contacto y pie de página
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PHONE=
# Página de citas de Google Calendar (Appointment Schedules): https://calendar.google.com/calendar/appointments/schedules/...
NEXT_PUBLIC_BOOKING_URL=
# Dominio final (activa hreflang, sitemap y datos estructurados). Ej.: https://www.tudominio.com
NEXT_PUBLIC_SITE_URL=
# Cambiar a "true" SOLO al lanzar: permite que Google indexe el sitio.
NEXT_PUBLIC_INDEXABLE=

# ── Chatbot con IA (secreto: solo servidor) ──────────────────────────────────
# Con la clave puesta el chatbot se activa solo. Sin ella el widget indica que llegará pronto.
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5-5. Para un chat público se puede usar uno más económico, ej.: claude-haiku-5-5
ANTHROPIC_MODEL=
# Opcional. "false" apaga el chatbot aunque exista la clave.
CHAT_ENABLED=
# Opcional. Tope global de mensajes por día (control de costo). Por defecto 300.
CHAT_DAILY_LIMIT=

# ── Formulario de contacto (proveedor de correo por definir) ─────────────────
CONTACT_EMAIL_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
